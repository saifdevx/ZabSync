# ZabSync Checkpoint 3
# Recommended first run: npm ci -> npm run setup:demo -> npm run dev
# The API seeds the demonstration database on its first demo startup.
# Keep your real .env private. Never include it or service-account JSON in a ZIP.

# Local demo defaults. Demo mode refuses production/non-loopback operation.
AUTH_MODE=demo
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Local SQL file: no Turso account needed.
# For remote libSQL-compatible Turso, set DATABASE_URL and DATABASE_AUTH_TOKEN.
# Use a separate clean database when configuring real Firebase accounts.
DATABASE_URL=file:./data/campus.db
DATABASE_AUTH_TOKEN=

APP_NAME=ZabSync
# Campus website. The interface also has a separate official ZABDESK shortcut.
UNIVERSITY_URL=https://szabist-isb.edu.pk/

# Real mode: set AUTH_MODE=firebase and complete the following fields.
# Owner bootstrap is explicit. Use an address that you control and can verify.
# A separate Gmail owner requires BOTH exact private values below. Other Gmail
# accounts remain rejected. Keep your university account separate for class use.
# Get the immutable UID from Firebase Authentication -> Users, not a browser role.
# A UID pin is also recommended for a university owner. Never use VITE_ here.
# Existing ownership does not move when these values change: see OWNER_ACCOUNT.md.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_UID=

# Firebase WEB APP configuration: public identifiers delivered to the browser.
# Values come from Firebase Project settings -> Your apps -> Web app config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase ADMIN credentials: server secrets, never public/VITE_ variables.
# Recommended local method: enable Application Default Credentials and point
# GOOGLE_APPLICATION_CREDENTIALS at your private service-account JSON file.
# Keep that file outside this project and outside any public/shared folder.
FIREBASE_USE_APPLICATION_DEFAULT=false
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative to the JSON-file method: private server environment variables.
# Leave blank when using Application Default Credentials.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Student email eligibility is fixed to szabist-isb.pk. The one exact configured
# owner identity is the only external-email exception; its email and UID are private.
# Class scheduling timezone is currently fixed to Asia/Karachi.
# See docs/CONFIGURATION_CHECKLIST.md before configuring real accounts.
# See docs/OWNER_ACCOUNT.md for owner setup and controlled ownership transfer.

# Checkpoint 3 private file storage. Local demo needs no cloud account.
# Keep this directory OUTSIDE client/public and dist/client.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
UPLOAD_TEMP_DIR=./data/tmp

# For cloud deployment use STORAGE_DRIVER=r2 and keep the bucket private.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
