# ZabSync Checkpoint 4 — version 0.4.0
# Recommended first run: npm ci -> npm run setup:demo -> npm run dev
# The API seeds the demonstration database on its first demo startup.
# Keep your real .env private. Never include it or service-account JSON in a ZIP.

# Local demo defaults. Demo mode refuses production/non-loopback operation.
AUTH_MODE=demo
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Local SQL file: no Turso account needed.
# For remote libSQL-compatible Turso, set DATABASE_URL and DATABASE_AUTH_TOKEN.
# Use a separate clean database when configuring real Firebase accounts.
DATABASE_URL=file:./data/campus.db
DATABASE_AUTH_TOKEN=

APP_NAME=ZabSync
# Campus website. The interface also has a separate official ZABDESK shortcut.
UNIVERSITY_URL=https://szabist-isb.edu.pk/

# Real mode: set AUTH_MODE=firebase and complete the following fields.
# Owner bootstrap is explicit. Use an address that you control and can verify.
# A separate Gmail owner requires BOTH exact private values below. Other Gmail
# accounts remain rejected. Keep your university account separate for class use.
# Get the immutable UID from Firebase Authentication -> Users, not a browser role.
# A UID pin is also recommended for a university owner. Never use VITE_ here.
# Existing ownership does not move when these values change: see OWNER_ACCOUNT.md.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_UID=

# Firebase WEB APP configuration: public identifiers delivered to the browser.
# Values come from Firebase Project settings -> Your apps -> Web app config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Optional Google sign-in. Enable the Google provider in Firebase first.
# University mailboxes may not be Google accounts; email/password stays available.
# Google application sign-in does not grant Google Drive access.
FIREBASE_GOOGLE_SIGN_IN_ENABLED=false

# Firebase ADMIN credentials: server secrets, never public/VITE_ variables.
# Recommended local method: enable Application Default Credentials and point
# GOOGLE_APPLICATION_CREDENTIALS at your private service-account JSON file.
# Keep that file outside this project and outside any public/shared folder.
FIREBASE_USE_APPLICATION_DEFAULT=false
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative to the JSON-file method: private server environment variables.
# Leave blank when using Application Default Credentials.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Student email eligibility is fixed to szabist-isb.pk. The one exact configured
# owner identity is the only external-email exception; its email and UID are private.
# Class scheduling timezone is currently fixed to Asia/Karachi.
# See docs/CHECKPOINT_4_GUIDE.md before configuring real accounts.
# See docs/OWNER_ACCOUNT.md for owner setup and controlled ownership transfer.

# Base private file storage: avatars, small objects, existing files and an
# explicitly selected resource fallback. Chat text and app records live in SQL.
# Local demo needs no cloud account.
# Keep this directory OUTSIDE client/public and dist/client.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
UPLOAD_TEMP_DIR=./data/tmp

# For cloud deployment use STORAGE_DRIVER=r2 and keep the bucket private.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Aggregate base-store allowance. 8192 MiB leaves headroom below R2's 10 GB-month
# Standard free storage allowance; provider request/billing limits are separate.
BASE_STORAGE_LIMIT_MIB=8192

# Shared-resource destination: blank automatically uses Drive when fully
# configured, otherwise base storage. Set drive or base explicitly when needed.
# A failed Drive upload is never silently charged to the base store.
RESOURCE_STORAGE=

# Optional private Google Drive OAuth connection (Firebase real-account mode).
# Configure ALL four required values together. Use a Web application OAuth
# client and the narrow drive.file scope. Keep every value here on the server.
# Redirect: https://YOUR_HOST/oauth/google-drive/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back up this key separately. Replacing it prevents decrypting old connections.
DRIVE_TOKEN_ENCRYPTION_KEY=
# Optional exact /account URL on ALLOWED_ORIGINS; defaults to its first origin.
# Production callback and return URL must share the same HTTPS origin.
DRIVE_RETURN_URL=

# Upload ceilings in MiB. Trashed resources still count toward section usage.
# These apply to Drive as well as local/R2 resources.
RESOURCE_MAX_DOCUMENT_MIB=25
RESOURCE_MAX_VIDEO_MIB=100
CLASS_STORAGE_MIB=500

# In-app reminders work without push. Device push requires real Firebase
# configuration, a supported browser and the user's permission on that device.
REMINDERS_PUSH_ENABLED=false
FIREBASE_WEB_PUSH_VAPID_KEY=
FIREBASE_MESSAGING_SENDER_ID=

# Optional bounded Help assistant. Published Help search works without AI.
# API credentials are private; never use a VITE_ prefix for these values.
# Choose an OpenAI model supporting Responses API strict structured output.
HELP_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
HELP_AI_USER_DAILY=5
HELP_AI_GLOBAL_DAILY=100

# Backup exports contain private records and encrypted connection credentials.
# See docs/BACKUP_AND_RESTORE.md. Restore requires an empty target database.
# BACKUP_TARGET_AUTH_TOKEN=
