{
  "name": "zabsync",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "ZabSync — Built for Students. Designed for Success — checkpoint 4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:demo": "node scripts/setup-demo.mjs",
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && node scripts/stamp-web-build.mjs && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "db:migrate": "node --import tsx server/migrate.ts",
    "format": "prettier --write .",
    "owner:transfer": "node --import tsx server/owner-transfer-cli.ts",
    "reminders:once": "node --import tsx server/reminder-runner.ts --once",
    "reminders:watch": "node --import tsx server/reminder-runner.ts --watch",
    "backup": "node --import tsx server/backup-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@libsql/client": "0.18.0",
    "dotenv": "18.0.7",
    "fastify": "5.12.7",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "jszip": "3.10.2",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
